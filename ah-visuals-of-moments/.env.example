# Public Site URL used for sitemap, canonical URLs, and Open Graph metadata.
# In production, set this to your domain (e.g. https://ahvisuals.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true to allow search engines to index the site.
# Defaults to false (disallow indexing with noindex metadata, Disallow: /, and X-Robots-Tag).
NEXT_PUBLIC_ALLOW_INDEXING=false

