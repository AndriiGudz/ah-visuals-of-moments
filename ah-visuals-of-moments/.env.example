# ==============================================================================
# AH Visuals of Moments: Environment Variables Configuration
# ==============================================================================

# Public Site URL used for sitemap, canonical URLs, Open Graph metadata, and QR codes.
# Local Development: http://localhost:3000
# Netlify Production Environment: https://ah-visuals.com (MANDATORY IN PRODUCTION)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true to allow search engines to index the site.
# Defaults to false (disallow indexing with noindex metadata, Disallow: /, and X-Robots-Tag).
NEXT_PUBLIC_ALLOW_INDEXING=false

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Configuration (Single Source of Truth)
# ------------------------------------------------------------------------------
# Public Supabase URL and Publishable Key (safe for client queries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=pk_your-publishable-key-here

# Supabase Secret Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used for administrative operations, inventory adjustments, and atomic RPC calls.
SUPABASE_SECRET_KEY=sk_your-secret-key-here

# ------------------------------------------------------------------------------
# Administrative Authentication (/admin)
# ------------------------------------------------------------------------------
# Secure password required to access the admin dashboard
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production

# Secret key used to sign and verify admin session cookies (min 32 characters)
ADMIN_SESSION_SECRET=super_secret_32_char_minimum_signing_key_here!

# ------------------------------------------------------------------------------
# Google Sheets API Integration (Service Account)
# ------------------------------------------------------------------------------
# Google Cloud Service Account Email (share target Google Sheets with this address as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=ah-visuals-sheets@your-project-id.iam.gserviceaccount.com

# Google Cloud Service Account Private Key (with escaped newlines or valid PEM format)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Default Google Spreadsheet ID (SERVER-SIDE ONLY - NEVER USE NEXT_PUBLIC_*)
# Used automatically as fallback in admin if no active integration is stored in the database.
# Priority: google_integrations table (DB) -> GOOGLE_DEFAULT_SPREADSHEET_ID (ENV) -> empty
GOOGLE_DEFAULT_SPREADSHEET_ID=

# ------------------------------------------------------------------------------
# Telegram Order Notifications
# ------------------------------------------------------------------------------
# Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Target Chat ID or Channel/Group ID for new order alerts
TELEGRAM_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# Test Runner Configuration
# ------------------------------------------------------------------------------
# When set to true, tests will run against the hosted Supabase instance.
# Defaults to false (all tests run against isolated in-memory mock state).
RUN_HOSTED_INTEGRATION_TESTS=false

